# Development-only candidate. Build using the locally tested HAOS image:
# docker build -t xmrig-haos-legacy:local ./xmrig_haos
# docker build -f tests/runtime/Dockerfile.haos-python -t xmrig-haos-python:local .
# Never push this image or replace the production add-on from this file.
FROM xmrig-haos-legacy:local

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends python3 python3-venv; \
    python3 -c 'import sys; assert sys.version_info >= (3, 10)'; \
    python3 -m venv /opt/xmrig-venv; \
    /opt/xmrig-venv/bin/pip install --no-cache-dir "paho-mqtt==2.1.0"; \
    rm -rf /var/lib/apt/lists/*

COPY xmrig_haos/rootfs/app/ /opt/xmrig/app/

WORKDIR /opt/xmrig
ENV PYTHONPATH=/opt/xmrig PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Kept in a separate test-only image. No GHCR publishing.
ENTRYPOINT ["/opt/xmrig-venv/bin/python", "-m", "app.main"]
